{
    "name": "easycorp/easyadmin-bundle",
    "type": "symfony-bundle",
    "description": "Admin generator for Symfony applications",
    "keywords": ["backend", "admin", "generator"],
    "homepage": "https://github.com/EasyCorp/EasyAdminBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Project Contributors",
            "homepage": "https://github.com/EasyCorp/EasyAdminBundle/blob/master/CONTRIBUTORS.md"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "doctrine/common": "^3.5",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.1",
        "pagerfanta/core": "^4.8",
        "pagerfanta/doctrine-orm-adapter": "^4.8",
        "symfony/asset": "^7.4|^8.0",
        "symfony/cache": "^7.4|^8.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/doctrine-bridge": "^7.4|^8.0",
        "symfony/error-handler": "^7.4|^8.0",
        "symfony/event-dispatcher": "^7.4|^8.0",
        "symfony/expression-language": "^7.4|^8.0",
        "symfony/finder": "^7.4|^8.0",
        "symfony/form": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/polyfill-mbstring": "^1.7",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/security-bundle": "^7.4|^8.0",
        "symfony/translation": "^7.4|^8.0",
        "symfony/twig-bridge": "^7.4|^8.0",
        "symfony/twig-bundle": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0",
        "twig/twig": "^3.24"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^2.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "psr/log": "^1|^2|^3",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/css-selector": "^7.4|^8.0",
        "symfony/dom-crawler": "^7.4|^8.0",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "symfony/var-dumper": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "symfony/doctrine-bridge": "source",
            "*": "dist"
        }
    },
    "autoload": {
        "psr-4": {
            "EasyCorp\\Bundle\\EasyAdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTestBundle\\": "tests/Fixtures/AppTestBundle/",
            "EasyCorp\\Bundle\\EasyAdminBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    }
}
